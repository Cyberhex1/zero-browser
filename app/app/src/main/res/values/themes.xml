<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="overscan_h">48dp</dimen>
    <dimen name="overscan_v">27dp</dimen>

    <style name="Theme.TvBrowser" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:alertDialogTheme">@style/Theme.Arcade.Dialog</item>
    </style>

    <!-- Arcade dialogs: dark square panel, cyan buttons. Used by tvDialog(). -->
    <style name="Theme.Arcade.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:buttonBarButtonStyle">@style/Arcade.DialogButton</item>
    </style>

    <style name="Arcade.DialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
