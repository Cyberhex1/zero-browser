<?xml version="1.0" encoding="utf-8"?>
<!-- Web pages fill the screen; root padding is the optional "Screen border" setting.
     Our own UI (top bar, Zero Home) keeps a safe-area margin of its own. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="#FFD54F"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/popup_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:paddingLeft="140dp"
        android:paddingRight="140dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#202124"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="@string/popup_hint"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <org.mozilla.geckoview.GeckoView
                android:id="@+id/popup_gecko"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Zero Home; content is built by HomeScreen. -->
    <ScrollView
        android:id="@+id/home_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121316"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingLeft="@dimen/overscan_h"
        android:paddingRight="@dimen/overscan_h"
        android:paddingTop="@dimen/overscan_v"
        android:paddingBottom="@dimen/overscan_v"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginLeft="@dimen/overscan_h"
        android:layout_marginRight="@dimen/overscan_h"
        android:layout_marginTop="@dimen/overscan_v"
        android:background="#F2202124"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/focus_bg"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="56dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back"
                style="@style/TvButton"
                android:text="@string/back" />

            <Button
                android:id="@+id/btn_forward"
                style="@style/TvButton"
                android:text="@string/forward" />

            <Button
                android:id="@+id/btn_reload"
                style="@style/TvButton"
                android:text="@string/reload" />

            <Button
                android:id="@+id/btn_home"
                style="@style/TvButton"
                android:text="@string/home" />

            <Button
                android:id="@+id/btn_save"
                style="@style/TvButton"
                android:text="@string/save_to_home" />

            <Button
                android:id="@+id/btn_addons"
                style="@style/TvButton"
                android:text="@string/addons" />

            <Button
                android:id="@+id/btn_settings"
                style="@style/TvButton"
                android:text="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/extensions"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/action_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Small view moved by translation; see CursorView. -->
    <app.zerobrowser.CursorView
        android:id="@+id/cursor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start" />
</FrameLayout>
